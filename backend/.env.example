# FirstAid Backend Configuration

# Flask Environment
FLASK_ENV=development
FLASK_PORT=5000

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-12345

# Database (if using a real database in future)
DATABASE_URL=sqlite:///firstaid.db

# File Upload Configuration
MAX_UPLOAD_SIZE=50

# OCR Configuration
TESSERACT_PATH=/usr/local/bin/tesseract

# Environment
DEBUG=True

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
